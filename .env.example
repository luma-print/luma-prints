PORT=3000
BASE_URL=http://localhost:3000        # your public URL in production, e.g. https://lumaprints.onrender.com
ADMIN_PASSWORD=change-this-password   # or put it in Render secret file /etc/secrets/admin_password
SHIPPING_FEE=5.00                     # placeholder flat shipping fee – set your own
STRIPE_SECRET_KEY=                    # sk_test_... or sk_live_... (blank = demo mode)
DATA_DIR=                             # optional: persistent disk path for orders/uploads
# Email: new orders (photos attached) + contact messages go to OWNER_EMAIL; customers get a confirmation
OWNER_EMAIL=Luma.prints1@gmail.com
# Preferred on Render (free plan blocks SMTP): Brevo HTTPS API. If set, SMTP below is ignored.
BREVO_API_KEY=
# SMTP fallback (local/other hosts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Luma.prints1@gmail.com
SMTP_PASS=                            # 16-character Gmail App Password (NOT your normal password)
SMTP_FROM=Luma.prints1@gmail.com
MAX_ATTACH_MB=10                      # photos beyond this go as admin download links (Brevo limit ~20 MB encoded)
